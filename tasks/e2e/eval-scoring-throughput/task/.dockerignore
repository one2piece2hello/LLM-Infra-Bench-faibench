tests/
loop_overlay/
**/__pycache__/
**/*.pyc
*.bak_*
*.orig_*
Dockerfile.orig_private_base
Dockerfile.close_sa5_overlay
Dockerfile.deleak_overlay
Dockerfile.rebuild_clean
