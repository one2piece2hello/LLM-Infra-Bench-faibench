 """
 import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _blocksp_matmul_kernel(a_ptr, wb_ptr, kidx_ptr, c_ptr,
+                           M, N, K, NNZ, BLOCK_K,
+                           stride_am, stride_ak, stride_wbk, stride_wbn,
+                           stride_cm, stride_cn,
+                           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr,
+                           BK: tl.constexpr, KT: tl.constexpr, GROUP_M: tl.constexpr):
+    # One program computes a [BLOCK_M, BLOCK_N] output tile by summing the contributions of
+    # the NNZ stored nonzero K-blocks (each of BK = block_k rows). The K-dim of each block
+    # is tiled into fixed KT-sized chunks so the tl.dot tile (and its pipelined shared-memory
+    # footprint) stays bounded regardless of block_k. KT divides BK (block_k is a multiple
+    # of 32; KT in {32, 64}).
+    pid = tl.program_id(0)
+    num_pid_m = tl.cdiv(M, BLOCK_M)
+    num_pid_n = tl.cdiv(N, BLOCK_N)
+    num_pid_in_group = GROUP_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)
+    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_kt = tl.arange(0, KT)
+    n_mask = offs_n < N
+
+    a_base = a_ptr + offs_m[:, None] * stride_am
+    n_steps = BK // KT                                       # KT-chunks per stored block (constexpr)
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for p in range(0, NNZ):
+        kb = tl.load(kidx_ptr + p)                           # logical block index of stored block p
+        wb_row0 = p * BK                                     # first row of this stored block in w_blocks
+        for t in range(0, n_steps):
+            r0 = t * KT
+            k_cols = kb * BK + r0 + offs_kt                  # [KT] logical K columns of this chunk
+            a_sub = tl.load(a_base + k_cols[None, :] * stride_ak,
+                            mask=(offs_m[:, None] < M) & (k_cols[None, :] < K), other=0.0)  # [BLOCK_M, KT]
+            w_rows = wb_row0 + r0 + offs_kt                  # [KT] rows in w_blocks
+            w_sub = tl.load(wb_ptr + w_rows[:, None] * stride_wbk + offs_n[None, :] * stride_wbn,
+                            mask=(w_rows[:, None] < NNZ * BK) & (offs_n[None, :] < N), other=0.0)  # [KT, BLOCK_N]
+            acc += tl.dot(a_sub, w_sub)
+
+    c_ptrs = c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn
+    tl.store(c_ptrs, acc.to(tl.float16), mask=(offs_m[:, None] < M) & (offs_n[None, :] < N))
 
 
