+weight. The PUBLIC SIGNATURE and NUMERICAL CONTRACT are fixed and MUST be preserved;
+only the implementation in this file is in scope.
+
+BROKEN implementation: a single fused kernel streams the COMPRESSED weight tiles
+(``w_vals`` ``[K//2, N]`` + ``w_meta`` ``[K//4, N]``) from global memory and, per K-step
+covering a block of groups, reconstructs the corresponding dense ``[4*BLOCK_G, BLOCK_N]``
+weight tile ENTIRELY IN REGISTERS (a broadcasted 4-way select scatters each group's 2
+nonzeros to their metadata row), then accumulates ``a_tile @ w_tile`` with a matrix engine
+-- the dense ``[K, N]`` weight is NEVER written to or read from global memory, only the
+half-size compressed representation is streamed. A grouped program ordering improves L2
+locality.
 """
 import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _sp24mm_matmul_kernel(a_ptr, wv_ptr, wm_ptr, c_ptr,
+                          M, N, K,
+                          stride_am, stride_ak, stride_wvk, stride_wvn,
+                          stride_wmg, stride_wmn, stride_cm, stride_cn,
+                          BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr,
+                          BLOCK_G: tl.constexpr, GROUP_M: tl.constexpr):
+    # BLOCK_G = number of 4-row K-groups per K-step; BLOCK_K = 4*BLOCK_G logical K rows.
+    pid = tl.program_id(0)
+    num_pid_m = tl.cdiv(M, BLOCK_M)
+    num_pid_n = tl.cdiv(N, BLOCK_N)
+    num_pid_in_group = GROUP_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)
+    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_g = tl.arange(0, BLOCK_G)                      # group offsets within a K-step
+    offs_r = tl.arange(0, 4)                            # in-group row [0,4)
+    offs_bk = tl.arange(0, BLOCK_G * 4)                 # logical-K offsets within a K-step
+    n_mask = offs_n < N
+    Kg = K // 4
+
+    a_base = a_ptr + offs_m[:, None] * stride_am
+    wv_base = wv_ptr + offs_n[None, :] * stride_wvn
+    wm_ptrs = wm_ptr + offs_g[:, None] * stride_wmg + offs_n[None, :] * stride_wmn
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    num_ksteps = tl.cdiv(Kg, BLOCK_G)
+    for k0 in range(0, num_ksteps):
+        g_base = k0 * BLOCK_G
+        g_off = g_base + offs_g                          # [BLOCK_G]
+        gmask = (g_off[:, None] < Kg) & (offs_n[None, :] < N)
+        meta = tl.load(wm_ptrs, mask=gmask, other=0).to(tl.int32)     # [BLOCK_G, BLOCK_N]
+        i0 = (meta & 0x3)
+        i1 = ((meta >> 2) & 0x3)
+        v0 = tl.load(wv_base + (2 * g_off)[:, None] * stride_wvk,
+                     mask=gmask, other=0.0).to(tl.float32)            # [BLOCK_G, BLOCK_N]
+        v1 = tl.load(wv_base + (2 * g_off + 1)[:, None] * stride_wvk,
+                     mask=gmask, other=0.0).to(tl.float32)
+        # reconstruct the dense per-group weight in registers: w_stack[g, r, n] =
+        # (i0==r ? v0 : 0) + (i1==r ? v1 : 0), broadcasting the in-group row axis r.
+        i0e = i0[:, None, :]                             # [BLOCK_G, 1, BLOCK_N]
+        i1e = i1[:, None, :]
+        v0e = v0[:, None, :]
+        v1e = v1[:, None, :]
+        r_ax = offs_r[None, :, None]                     # [1, 4, 1]
+        w_stack = tl.where(i0e == r_ax, v0e, 0.0)     # BUG: dropped the 2nd nonzero (i1/v1) of each 2:4 group
+        w_tile = tl.reshape(w_stack, (BLOCK_G * 4, BLOCK_N)).to(tl.float16)  # row bk = 4*g + r
+        # activation tile for this K-step: logical K = 4*g_base + offs_bk
+        k_cols = 4 * g_base + offs_bk
+        a_tile = tl.load(a_base + k_cols[None, :] * stride_ak,
+                         mask=(offs_m[:, None] < M) & (k_cols[None, :] < K), other=0.0)  # [BLOCK_M, BLOCK_G*4]
+        acc += tl.dot(a_tile, w_tile)
+        wm_ptrs += BLOCK_G * stride_wmg
+
+    c_ptrs = c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn
+    tl.store(c_ptrs, acc.to(tl.float16), mask=(offs_m[:, None] < M) & (offs_n[None, :] < N))
 
 
