+__global__ void sgemm_smem_tiled_kernel(const float* __restrict__ A,
+                                        const float* __restrict__ B,
+                                        const float* __restrict__ C,
+                                        float* __restrict__ D,
+                                        int M, int N, int K,
+                                        float alpha, float beta) {
+    __shared__ float As[BT][BT];
+    __shared__ float Bs[BT][BT];
+    const int ty = threadIdx.y;
+    const int tx = threadIdx.x;
+    const int row = blockIdx.y * BT + ty;
+    const int col = blockIdx.x * BT + tx;
+
+    float acc = 0.0f;
+    const int ntiles = (K + BT - 1) / BT;
+    for (int t = 0; t < ntiles; ++t) {
+        const int aCol = t * BT + tx;
+        const int bRow = t * BT + ty;
+        As[ty][tx] = (row < M && aCol < K) ? A[row * K + aCol] : 0.0f;
+        Bs[ty][tx] = (bRow < K && col < N) ? B[bRow * N + col] : 0.0f;
+        __syncthreads();
+#pragma unroll
+        for (int k = 0; k < BT; ++k) {
+            acc += As[ty][k] * Bs[k][tx];   // float32 accumulate
         }
+        __syncthreads();
+    }
+    if (row < M && col < N) {
         const int idx = row * N + col;
         D[idx] = alpha * acc + beta * C[idx];
     }
