+    bx = xf.unsqueeze(-1) * Bf.unsqueeze(2)          # (B, L, D, N)
+
+    chunk = 64
+    pad = (-L) % chunk
+    if pad:
+        # pad with identity transitions (A=1) and zero drive so padded steps do not
+        # perturb the real states; sliced off at the end.
+        Af = torch.cat([Af, Af.new_ones(Bsz, pad, D, N)], dim=1)
+        bx = torch.cat([bx, bx.new_zeros(Bsz, pad, D, N)], dim=1)
+    Lp = L + pad
+    nc = Lp // chunk
+    Ac = Af.view(Bsz, nc, chunk, D, N)
+    Xc = bx.view(Bsz, nc, chunk, D, N)
+
+    # intra-chunk: sequential prefix (h_in = 0) + cumulative transition product, all
+    # chunks in parallel. Only `chunk` sequential steps.
+    h_local = torch.zeros(Bsz, nc, D, N, dtype=torch.float32, device=A.device)
+    local = []
+    for j in range(chunk):
+        h_local = Ac[:, :, j] * h_local + Xc[:, :, j]
+        local.append(h_local)
+    local = torch.stack(local, dim=2)                # (B, nc, chunk, D, N)
+    Acum = torch.cumprod(Ac, dim=2)                  # inclusive per-chunk transition product
+
+    # inter-chunk: carry the boundary state across the (few) chunks sequentially.
+    carry = torch.zeros(Bsz, D, N, dtype=torch.float32, device=A.device)
+    carries = []
+    chunk_A = Acum[:, :, -1]                          # (B, nc, D, N) full-chunk transition
+    chunk_final = local[:, :, -1]                     # (B, nc, D, N) local final state
+    for c in range(nc):
+        carries.append(carry)                         # state entering chunk c
+        carry = chunk_A[:, c] * carry + chunk_final[:, c]
+    carries = torch.stack(carries, dim=1)            # (B, nc, D, N)
+
+    # combine: h[chunk c, step j] = local + (cumulative A up to j) * incoming carry
+    h = local + Acum * carries.unsqueeze(2)          # (B, nc, chunk, D, N)
+    h = h.reshape(Bsz, Lp, D, N)[:, :L]              # (B, L, D, N)
+    y = (h * Cf.unsqueeze(2)).sum(dim=-1)            # (B, L, D)
     return y.to(out_dtype)
