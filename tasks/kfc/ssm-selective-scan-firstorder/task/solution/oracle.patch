+def state_space_scan(A, B, C, x):
+    """See module docstring for the full contract."""
+    Bsz, L, D, N = _validate(A, B, C, x)
+    out_dtype = x.dtype
+    if L == 0:
+        return torch.empty((Bsz, 0, D), dtype=out_dtype, device=x.device)
+    if not (_HAS_TRITON and A.is_cuda):
+        return _torch_sequential(A, B, C, x, out_dtype)
+
+    A = A.contiguous()
+    B = B.contiguous()
+    C = C.contiguous()
+    x = x.contiguous()
+
+    CL = 64
+    G = (L + CL - 1) // CL
+    BN = _next_pow2(N)
+    BD = max(1, min(_next_pow2(D), 1024 // BN, 64))
+    num_warps = 2
+
+    P = torch.empty((Bsz, G, D, N), dtype=torch.float32, device=A.device)
+    H = torch.empty((Bsz, G, D, N), dtype=torch.float32, device=A.device)
+    S = torch.empty((Bsz, G, D, N), dtype=torch.float32, device=A.device)
+    y = torch.empty((Bsz, L, D), dtype=out_dtype, device=A.device)
+
+    num_db = (D + BD - 1) // BD
+    grid = (Bsz * G * num_db,)
+    _chunk_summary_kernel[grid](A, x, B, P, H, L, D, N, G, CL=CL, BD=BD, BN=BN,
+                                num_warps=num_warps)
+    if G > 1:
