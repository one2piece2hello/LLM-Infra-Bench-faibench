+def identity_key(spec):
+    source = _canon_source(spec.get("source", ""))
+    target = spec.get("target")
+    toolchain = spec.get("toolchain")
+    options = tuple(sorted({o for o in (spec.get("options") or []) if o not in NOOP_OPTIONS}))
+    variants = tuple(sorted(spec.get("variants") or []))
+    canon = (source, target, toolchain, options, variants)
