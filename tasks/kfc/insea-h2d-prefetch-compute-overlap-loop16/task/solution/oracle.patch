 import torch
 
+_PIPELINE_DEPTH = 2
+
+# Per (device, dtype) pipeline state: pinned staging slots, one event per slot,
+# and the dedicated H2D copy stream. Kept alive across calls so a slot is never
+# freed while a copy out of it may still be in flight; reuse of a slot (within
+# or across calls) is always gated on that slot's copy event.
+_PIPELINES = {}
+
+# Per-device stream used to write per-chunk outputs into the preallocated result
+# tensor, overlapped with the compute of subsequent chunks.
+_WRITEBACK_STREAMS = {}
+
+# Per (device, dtype) state for the batched-transfer path used when there are
+# many small chunks: one pinned staging buffer, one event, one copy stream.
+_BATCH_PIPELINES = {}
+
+# Chunks at most this many bytes each take the batched-transfer path when there
+# are enough of them (per-chunk launch overhead would otherwise dominate).
+_BATCH_MAX_CHUNK_BYTES = 262144
+_BATCH_MIN_CHUNKS = 8
+# Never stage more than this many bytes in one pinned batch buffer.
+_BATCH_MAX_TOTAL_BYTES = 512 << 20
+
+# Resident pinned-source cache: pageable chunks are staged into pinned host
+# memory once per (storage, version, shape, dtype) and subsequent calls copy
+# H2D straight out of the pinned copy, skipping the host->host staging memcpy.
+# Entries hold a strong reference to their source tensor so a cached data_ptr
+# can never be recycled by a different tensor, and torch's autograd version
+# counter invalidates entries when a chunk is mutated in place. Only used for
+# workloads up to _SOURCE_CACHE_USE_BYTES; the cache itself is capped at
+# _SOURCE_CACHE_MAX_BYTES with oldest-first eviction.
+_SOURCE_CACHE = {}
+_SOURCE_CACHE_TOTAL = [0]
+_SOURCE_CACHE_USE_BYTES = 256 << 20
+_SOURCE_CACHE_MAX_BYTES = 512 << 20
+
+
+def _cached_pinned_source(c):
+    """Return a pinned host copy of chunk ``c``, or None if pinning fails."""
+    key = (c.data_ptr(), c._version, tuple(c.shape), c.dtype)
+    ent = _SOURCE_CACHE.get(key)
+    if ent is not None and ent[0] is c:
+        _SOURCE_CACHE[key] = _SOURCE_CACHE.pop(key)  # refresh LRU position
+        return ent[1]
+    try:
+        pinned = torch.empty(c.shape, dtype=c.dtype, pin_memory=True)
+    except RuntimeError:
+        return None
+    pinned.copy_(c)
+    nbytes = c.numel() * c.element_size()
+    _SOURCE_CACHE[key] = (c, pinned, nbytes)
+    _SOURCE_CACHE_TOTAL[0] += nbytes
+    if _SOURCE_CACHE_TOTAL[0] > _SOURCE_CACHE_MAX_BYTES:
+        # Rare path: make sure no H2D copy out of any evicted pinned buffer is
+        # still in flight before the buffers can be released and reused.
+        torch.cuda.synchronize()
+        while (_SOURCE_CACHE_TOTAL[0] > _SOURCE_CACHE_MAX_BYTES
+               and _SOURCE_CACHE):
+            _, (_, _, evicted) = _SOURCE_CACHE.popitem(last=False)
+            _SOURCE_CACHE_TOTAL[0] -= evicted
+    return pinned
+
+
+def _writeback_stream_for(device):
+    stream = _WRITEBACK_STREAMS.get(device.index)
+    if stream is None:
+        stream = torch.cuda.Stream(device)
+        _WRITEBACK_STREAMS[device.index] = stream
+    return stream
+
 
