+def _pipeline_for(device, dtype, max_numel):
+    key = (device.index, dtype)
+    st = _PIPELINES.get(key)
+    if st is None:
+        st = {
+            "stream": torch.cuda.Stream(device),
+            "slots": [torch.empty(max_numel, dtype=dtype, pin_memory=True)
+                      for _ in range(_PIPELINE_DEPTH)],
+            "events": [torch.cuda.Event() for _ in range(_PIPELINE_DEPTH)],
+            "in_flight": [False] * _PIPELINE_DEPTH,
+            "capacity": max_numel,
+        }
+        _PIPELINES[key] = st
+    elif max_numel > st["capacity"]:
+        # Rare growth path: drain outstanding copies before releasing the old
+        # (too small) pinned buffers.
+        for s in range(_PIPELINE_DEPTH):
+            if st["in_flight"][s]:
+                st["events"][s].synchronize()
+                st["in_flight"][s] = False
+        st["slots"] = [torch.empty(max_numel, dtype=dtype, pin_memory=True)
+                       for _ in range(_PIPELINE_DEPTH)]
+        st["capacity"] = max_numel
+    return st
+
+
+def _batched_small(chunks, compute, device, compute_stream, dtype):
+    """Fast path for many small chunks.
+
+    Per-chunk host overhead (stream switches, per-copy events, per-chunk device
+    allocations) dominates when every chunk is tiny, so the whole transfer is
+    batched: all chunks are staged into one pinned buffer, moved with a single
+    asynchronous H2D copy into one device buffer, and ``compute`` is applied
+    once per chunk on views into that buffer. Outputs are scattered into the
+    preallocated result on the compute stream as they are produced.
+    """
+    key = (device.index, dtype)
+    st = _BATCH_PIPELINES.get(key)
+    total_numel = 0
+    for c in chunks:
+        total_numel += c.numel()
+    if st is None:
+        st = {
+            "stream": torch.cuda.Stream(device),
+            "stage": torch.empty(max(total_numel, 1), dtype=dtype, pin_memory=True),
+            "event": torch.cuda.Event(),
+            "in_flight": False,
+            "capacity": max(total_numel, 1),
+        }
+        _BATCH_PIPELINES[key] = st
+    elif total_numel > st["capacity"]:
+        if st["in_flight"]:
+            st["event"].synchronize()
+            st["in_flight"] = False
+        st["stage"] = torch.empty(total_numel, dtype=dtype, pin_memory=True)
+        st["capacity"] = total_numel
+    if st["in_flight"]:
+        # Previous batched copy out of the staging buffer must be done.
+        st["event"].synchronize()
+        st["in_flight"] = False
+
+    stage = st["stage"]
+    offsets = [0] * len(chunks)
+    off = 0
+    for i, c in enumerate(chunks):
+        offsets[i] = off
+        numel = c.numel()
+        if numel:
+            stage[off:off + numel].view(c.shape).copy_(c)
+        off += numel
+
+    copy_stream = st["stream"]
+    with torch.cuda.stream(copy_stream):
+        dev = torch.empty(max(total_numel, 1), dtype=dtype, device=device)
+        if total_numel:
+            dev.copy_(stage[:total_numel], non_blocking=True)
+        st["event"].record(copy_stream)
+    st["in_flight"] = True
+    compute_stream.wait_event(st["event"])
+
+    total_rows = 0
+    for c in chunks:
+        total_rows += c.shape[0]
+
+    result = None
+    r0 = 0
+    for i, c in enumerate(chunks):
+        numel = c.numel()
+        dv = dev[offsets[i]:offsets[i] + numel].view(c.shape)
+        out = compute(dv)
+        if result is None:
+            result = torch.empty((total_rows,) + tuple(out.shape[1:]),
+                                 dtype=out.dtype, device=device)
+        r1 = r0 + c.shape[0]
+        if r1 > r0:
+            result[r0:r1].copy_(out)
+        r0 = r1
+
+    dev.record_stream(compute_stream)
+    return result
+
