+_NOOP_OPS = ("Identity", "Cast")
+
+
+def _rewire(nodes, old, new):
+    """Redirect every input edge reading tensor ``old`` to tensor ``new``."""
+    if old == new:
+        return
+    for c in nodes:
+        c["inputs"] = [new if t == old else t for t in c["inputs"]]
+
+
+def _eliminate_noops(nodes, external):
+    """Delete Identity/Cast nodes (numeric no-ops), rewiring their readers to
+    the no-op's own input. When the no-op's output name is an external output
+    we cannot drop the name, so instead we rename the producer's output tensor
+    onto it (only when the producer's old name is not itself needed outside)."""
+    changed = False
+    prod = _producer(nodes)
+    for nd in list(nodes):
+        if nd["op"] not in _NOOP_OPS:
+            continue
+        inp = nd["inputs"][0]
+        out = nd["outputs"][0]
+        if out in external:
+            p = prod.get(inp)
+            if p is None or inp in external:
+                continue  # cannot drop the external name safely
+            p["outputs"] = [out if t == inp else t for t in p["outputs"]]
+            for c in nodes:
+                if c is not nd:
+                    c["inputs"] = [out if t == inp else t for t in c["inputs"]]
+        else:
+            _rewire(nodes, out, inp)
+        nodes.remove(nd)
+        changed = True
+    return changed
+
+
+def _cse(nodes, external):
+    """Merge nodes computing the same value (same op, inputs and attrs).
+    The earliest node survives; if exactly one of the two output names is an
+    external output, that name is kept (renaming the survivor if needed)."""
+    changed = False
+    by_key = {}
+    for nd in list(nodes):
+        key = (nd["op"], tuple(nd["inputs"]),
+               tuple(sorted((k, repr(v)) for k, v in nd.get("attrs", {}).items())))
+        out = nd["outputs"][0]
+        survivor = None
+        for cand in by_key.get(key, ()):
+            if not (out in external and cand["outputs"][0] in external):
+                survivor = cand
+                break
+        if survivor is None:
+            by_key.setdefault(key, []).append(nd)
+            continue
+        s_out = survivor["outputs"][0]
+        keep = out if out in external else s_out
+        if keep != s_out:  # nd's name is external: rename survivor onto it
+            _rewire(nodes, s_out, keep)
+            survivor["outputs"] = [keep if t == s_out else t
+                                   for t in survivor["outputs"]]
+        for c in nodes:
+            if c is not nd:
+                c["inputs"] = [keep if t == out else t for t in c["inputs"]]
+        nodes.remove(nd)
+        changed = True
+    return changed
+
+
+def _normalize(nodes, external):
+    """Rewrite ``nodes`` in place to an equivalent, more canonical form:
+    no numeric no-op nodes and no duplicated computations."""
+    while True:
+        a = _eliminate_noops(nodes, external)
+        b = _cse(nodes, external)
+        if not (a or b):
+            return
+
+
