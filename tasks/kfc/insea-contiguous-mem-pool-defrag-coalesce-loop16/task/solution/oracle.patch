+def _fixmax(path, end=None):
+    # repair subtree-max fields bottom-up along path[0:end]; every child below
+    # the start of the walk must already be final. Stops as soon as a node's
+    # stored max is still correct (then no ancestor can change either).
+    if end is None:
+        end = len(path)
+    for i in range(end - 1, -1, -1):
+        n = path[i]
+        m = n[1]
+        left = n[2]
+        right = n[3]
+        if left is not None and left[4] > m:
+            m = left[4]
+        if right is not None and right[4] > m:
+            m = right[4]
+        if m == n[4]:
+            break
+        n[4] = m
+
+
+def _fixmax_full(path):
+    # repair subtree-max fields bottom-up along the whole path; used when a
+    # node's own length was mutated before the walk, so no early stop is sound.
+    for i in range(len(path) - 1, -1, -1):
+        n = path[i]
+        m = n[1]
+        left = n[2]
+        right = n[3]
+        if left is not None and left[4] > m:
+            m = left[4]
+        if right is not None and right[4] > m:
+            m = right[4]
+        n[4] = m
 
 
