+@triton.jit
+def _channel_window_kernel_packed(
+    x_ptr, w_ptr, bias_ptr, y_ptr,
+    N, C, L2, n_ltiles,
+    stride_xb, stride_xc,
+    K: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    ROWS: tl.constexpr,
+    BLOCK_P: tl.constexpr,
+    EVEN: tl.constexpr,
+    WIDE: tl.constexpr,
+    EK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    l_tile = pid % n_ltiles
+    r_tile = pid // n_ltiles
+
+    if EK == 2:
+        x_unit = tl.cast(x_ptr, tl.pointer_type(tl.int64), bitcast=True)
+    else:
+        x_unit = tl.cast(x_ptr, tl.pointer_type(tl.int32), bitcast=True)
+
+    offs_r = r_tile * ROWS + tl.arange(0, ROWS)
+    offs_p = l_tile * BLOCK_P + tl.arange(0, BLOCK_P)
+    rmask = offs_r < N
+    lmask = offs_p < L2
+
+    b = offs_r // C
+    c = offs_r - b * C
+    row_off = b * stride_xb + c * stride_xc
+    if WIDE:
+        row_off = row_off.to(tl.int64)
+    x_base = x_unit + row_off[:, None]
+
+    wbase = w_ptr + c * K
+    M: tl.constexpr = K // 2
+    A0 = _ld_pairs(x_base, offs_p, 0, l_tile, rmask, lmask, EVEN)
+    if M >= 1:
+        A1 = _ld_pairs(x_base, offs_p, 1, l_tile, rmask, lmask, EVEN)
+    if M >= 2:
+        A2 = _ld_pairs(x_base, offs_p, 2, l_tile, rmask, lmask, EVEN)
+    if M >= 3:
+        A3 = _ld_pairs(x_base, offs_p, 3, l_tile, rmask, lmask, EVEN)
+    if M >= 4:
+        A4 = _ld_pairs(x_base, offs_p, 4, l_tile, rmask, lmask, EVEN)
+
+    acc_lo = tl.zeros((ROWS, BLOCK_P), dtype=tl.float32)
+    acc_hi = tl.zeros((ROWS, BLOCK_P), dtype=tl.float32)
+    for s in tl.static_range(K):
+        j = K - 1 - s
+        wj = tl.load(wbase + j).to(tl.float32)
+        # element pair (2i, 2i+1), shift s: x[2i - s] -> lo, x[2i + 1 - s] -> hi
+        if s == 0:
+            lo = _lo_f32(A0, EK); hi = _hi_f32(A0, EK)
+        elif s == 1:
+            lo = _hi_f32(A1, EK); hi = _lo_f32(A0, EK)
+        elif s == 2:
+            lo = _lo_f32(A1, EK); hi = _hi_f32(A1, EK)
+        elif s == 3:
+            lo = _hi_f32(A2, EK); hi = _lo_f32(A1, EK)
+        elif s == 4:
+            lo = _lo_f32(A2, EK); hi = _hi_f32(A2, EK)
+        elif s == 5:
+            lo = _hi_f32(A3, EK); hi = _lo_f32(A2, EK)
+        elif s == 6:
+            lo = _lo_f32(A3, EK); hi = _hi_f32(A3, EK)
+        elif s == 7:
+            lo = _hi_f32(A4, EK); hi = _lo_f32(A3, EK)
+        else:
+            lo = _lo_f32(A4, EK); hi = _hi_f32(A4, EK)
+        acc_lo += wj[:, None] * lo
+        acc_hi += wj[:, None] * hi
