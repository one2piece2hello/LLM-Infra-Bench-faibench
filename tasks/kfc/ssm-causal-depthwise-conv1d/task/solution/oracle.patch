+@triton.jit
+def _channel_window_kernel(
+    x_ptr, w_ptr, bias_ptr, y_ptr,
+    N, C, L, n_ltiles,
+    stride_xb, stride_xc, stride_xl,
+    K: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    ROWS: tl.constexpr,
+    BLOCK_L: tl.constexpr,
+    EVEN: tl.constexpr,
+    WIDE: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    l_tile = pid % n_ltiles
+    r_tile = pid // n_ltiles
+
+    offs_r = r_tile * ROWS + tl.arange(0, ROWS)
+    offs_l = l_tile * BLOCK_L + tl.arange(0, BLOCK_L)
+    rmask = offs_r < N
+    lmask = offs_l < L
+
+    b = offs_r // C
+    c = offs_r - b * C
+    row_off = b * stride_xb + c * stride_xc
+    if WIDE:
+        row_off = row_off.to(tl.int64)
+    x_base = x_ptr + row_off[:, None]
+
+    wbase = w_ptr + c * K
+    acc = tl.zeros((ROWS, BLOCK_L), dtype=tl.float32)
+    for j in tl.static_range(K):
+        wj = tl.load(wbase + j).to(tl.float32)
+        src = offs_l - (K - 1) + j
+        ptrs = x_base + src[None, :] * stride_xl
+        if EVEN:
+            if l_tile == 0:
+                xv = tl.load(ptrs, mask=(src >= 0)[None, :], other=0.0)
+            else:
+                xv = tl.load(ptrs)
+        else:
+            m = rmask[:, None] & lmask[None, :]
+            if l_tile == 0:
+                m = m & (src >= 0)[None, :]
+            xv = tl.load(ptrs, mask=m, other=0.0)
+        acc += wj[:, None] * xv.to(tl.float32)
+    if HAS_BIAS:
+        acc += tl.load(bias_ptr + c).to(tl.float32)[:, None]
+
+    yv = acc * tl.sigmoid(acc)
+    if WIDE:
+        dst = y_ptr + offs_r.to(tl.int64)[:, None] * L + offs_l[None, :]
+    else:
+        dst = y_ptr + offs_r[:, None] * L + offs_l[None, :]
+    if EVEN:
+        tl.store(dst, yv.to(y_ptr.dtype.element_ty))
+    else:
+        tl.store(dst, yv.to(y_ptr.dtype.element_ty), mask=rmask[:, None] & lmask[None, :])
+
