+        dst = y_ptr + offs_r.to(tl.int64)[:, None] * (2 * L2) + offs_e[None, :]
+    else:
+        dst = y_ptr + offs_r[:, None] * (2 * L2) + offs_e[None, :]
+    if EVEN:
+        tl.store(dst, yy)
+    else:
+        tl.store(dst, yy, mask=rmask[:, None] & (offs_e < 2 * L2)[None, :])
+
