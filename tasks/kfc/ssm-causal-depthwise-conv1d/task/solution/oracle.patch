+@triton.jit
+def _ld_pairs(x_base, offs_p, m: tl.constexpr, l_tile, rmask, lmask,
+              EVEN: tl.constexpr):
+    src = offs_p - m
+    ptrs = x_base + src[None, :]
+    if EVEN:
+        if l_tile == 0:
+            res = tl.load(ptrs, mask=(src >= 0)[None, :], other=0)
+        else:
+            res = tl.load(ptrs)
+    else:
+        mm = rmask[:, None] & lmask[None, :]
+        if l_tile == 0:
+            mm = mm & (src >= 0)[None, :]
+        res = tl.load(ptrs, mask=mm, other=0)
+    return res
+
