+@triton.jit
+def _lo_f32(v, EK: tl.constexpr):
+    if EK == 2:  # fp32 pair in an int64 unit
+        return v.to(tl.int32).to(tl.float32, bitcast=True)
+    elif EK == 0:  # bf16 pair in an int32 unit
+        return (v << 16).to(tl.float32, bitcast=True)
+    else:  # fp16 pair in an int32 unit
+        return (v & 65535).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
+
+
+@triton.jit
+def _hi_f32(v, EK: tl.constexpr):
+    if EK == 2:
+        return (v >> 32).to(tl.int32).to(tl.float32, bitcast=True)
+    elif EK == 0:
+        return (v & -65536).to(tl.float32, bitcast=True)
+    else:
+        return ((v >> 16) & 65535).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
+
