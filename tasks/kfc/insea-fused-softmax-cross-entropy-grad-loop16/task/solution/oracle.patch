+    @triton.jit
+    def _count_valid_bad_kernel(
+        lab_ptr,  # (N,) int32/int64
+        stats_ptr,  # (2,) int64: [n_valid, n_bad] accumulated with exact integer atomics
+        N,
+        V,
+        ignore_index,
+        BLOCK: tl.constexpr,
+    ):
+        pid = tl.program_id(0)
+        offs = pid * BLOCK + tl.arange(0, BLOCK)
+        mask = offs < N
+        lab = tl.load(lab_ptr + offs, mask=mask, other=ignore_index)
+        is_valid = (lab != ignore_index) & mask
+        is_bad = is_valid & ((lab < 0) | (lab >= V))
+        tl.atomic_add(stats_ptr, tl.sum(is_valid.to(tl.int64), axis=0))
+        tl.atomic_add(stats_ptr + 1, tl.sum(is_bad.to(tl.int64), axis=0))
+
+    @triton.jit
+    def _ce_loss_grad_reg_kernel(
+        x_ptr,  # (N, V) in: logits, out: gradient (overwritten in place)
+        lab_ptr,  # (N,) int32/int64
+        loss_ptr,  # (N,) float32 per-row loss, 0 for ignored rows
+        V,
+        ignore_index,
+        s,
+        inv_denom,
+        BLOCK_V: tl.constexpr,  # >= V: the whole row stays resident in registers
+    ):
+        row = tl.program_id(0)
+        base = x_ptr + row.to(tl.int64) * V
+        cols = tl.arange(0, BLOCK_V)
+        mask = cols < V
+        lab = tl.load(lab_ptr + row)
+
+        if lab == ignore_index:
+            tl.store(loss_ptr + row, 0.0)
+            z = tl.zeros([BLOCK_V], dtype=tl.float32)
+            tl.store(base + cols, z.to(x_ptr.dtype.element_ty), mask=mask)
+        else:
+            x = tl.load(base + cols, mask=mask, other=-float("inf")).to(tl.float32)
+            m = tl.max(x, axis=0)
+            e = tl.exp(x - m)
+            l = tl.sum(e, axis=0)
+            sum_x = tl.sum(tl.where(mask, x, 0.0), axis=0)
+            x_y = tl.sum(tl.where(cols == lab, x, 0.0), axis=0)
+            log_z = m + tl.log(l)
+            row_loss = (1.0 - s) * (log_z - x_y) + s * (log_z - sum_x / V)
+            tl.store(loss_ptr + row, row_loss * inv_denom)
+            g = e * (1.0 / l) - s / V
+            g = tl.where(cols == lab, g - (1.0 - s), g)
+            g = g * inv_denom
+            tl.store(base + cols, g.to(x_ptr.dtype.element_ty), mask=mask)
+
+    @triton.jit
+    def _ce_loss_grad_kernel(
+        x_ptr,  # (N, V) in: logits, out: gradient (overwritten in place)
+        lab_ptr,  # (N,) int32/int64
+        loss_ptr,  # (N,) float32 per-row loss, 0 for ignored rows
+        V,
+        ignore_index,
+        s,
+        inv_denom,
+        BLOCK_V: tl.constexpr,
+    ):
+        row = tl.program_id(0)
+        base = x_ptr + row.to(tl.int64) * V
+        cols0 = tl.arange(0, BLOCK_V)
+        lab = tl.load(lab_ptr + row)
+
+        if lab == ignore_index:
+            tl.store(loss_ptr + row, 0.0)
+            z = tl.zeros([BLOCK_V], dtype=tl.float32)
+            for off in range(0, V, BLOCK_V):
+                cols = off + cols0
+                mask = cols < V
+                tl.store(base + cols, z.to(x_ptr.dtype.element_ty), mask=mask)
+        else:
+            m = -float("inf")
+            l = 0.0
+            sum_x = 0.0
+            x_y = 0.0
+            for off in range(0, V, BLOCK_V):
+                cols = off + cols0
+                mask = cols < V
+                x = tl.load(base + cols, mask=mask, other=-float("inf")).to(tl.float32)
+                bmax = tl.max(x, axis=0)
+                new_m = tl.maximum(m, bmax)
+                l = l * tl.exp(m - new_m) + tl.sum(tl.exp(x - new_m), axis=0)
+                m = new_m
+                sum_x += tl.sum(tl.where(mask, x, 0.0), axis=0)
+                x_y += tl.sum(tl.where(cols == lab, x, 0.0), axis=0)
+
+            log_z = m + tl.log(l)
+            row_loss = (1.0 - s) * (log_z - x_y) + s * (log_z - sum_x / V)
+            tl.store(loss_ptr + row, row_loss * inv_denom)
+
+            inv_l = 1.0 / l
+            s_over_v = s / V
+            om_s = 1.0 - s
+            for off in range(0, V, BLOCK_V):
+                cols = off + cols0
+                mask = cols < V
+                x = tl.load(base + cols, mask=mask, other=0.0).to(tl.float32)
+                g = tl.exp(x - m) * inv_l - s_over_v
+                g = tl.where(cols == lab, g - om_s, g)
+                g = g * inv_denom
+                tl.store(base + cols, g.to(x_ptr.dtype.element_ty), mask=mask)
+
