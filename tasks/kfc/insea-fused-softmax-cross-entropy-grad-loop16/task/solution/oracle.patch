+def _chunked_fallback(logits, labels, valid, s, inv_denom, loss_buf):
+    """Memory-bounded pure-torch path (non-CUDA tensors or missing triton)."""
+    N, V = logits.shape
+    chunk = max(1, min(N, (1 << 22) // max(V, 1)))
+    for c0 in range(0, N, chunk):
+        c1 = min(N, c0 + chunk)
+        x = logits[c0:c1]
+        xf = x.to(torch.float32)
+        m = xf.max(dim=1, keepdim=True).values
+        e = torch.exp(xf - m)
+        l = e.sum(dim=1, keepdim=True)
+        log_z = m + torch.log(l)
+        lab = labels[c0:c1].clamp(min=0).long()
+        idx = torch.arange(c1 - c0, device=logits.device)
+        x_y = xf[idx, lab].unsqueeze(1)
+        sum_x = xf.sum(dim=1, keepdim=True)
+        row_loss = ((1.0 - s) * (log_z - x_y) + s * (log_z - sum_x / V)).squeeze(1)
+        v = valid[c0:c1]
+        loss_buf[c0:c1] = torch.where(v, row_loss * inv_denom, torch.zeros_like(row_loss))
+        g = e / l - (s / V)
+        g[idx, lab] = g[idx, lab] - (1.0 - s)
+        g = g * inv_denom
+        g = torch.where(v.unsqueeze(1), g, torch.zeros_like(g))
+        x.copy_(g.to(logits.dtype))
+    return logits
