-    """
-    text = json.dumps(signature, sort_keys=True, separators=(",", ":"), default=repr)
-    return _fnv1a_64(text)
+    op = signature.get("op")
+    operands = [_norm_operand(o) for o in signature.get("operands", [])]
+    if op in COMMUTATIVE:
