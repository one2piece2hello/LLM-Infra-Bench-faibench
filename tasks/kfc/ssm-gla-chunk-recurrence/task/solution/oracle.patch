+    @triton.jit
+    def _gsr_intra_kernel(Q, K, V, G, O, scale,
+                          L, Lp, Dk, Dv, BH,
+                          BT: tl.constexpr, BC: tl.constexpr,
+                          BK: tl.constexpr, BV: tl.constexpr,
+                          NK: tl.constexpr, IP: tl.constexpr):
+        """Chunk-local output: pairs inside the same chunk (<= BT positions apart).
+
+        Grid: (ceil(L/BT) * ceil(Dv/BV) * NK, B*H). Each program walks the
+        sub-blocks of one chunk, maintaining a local state m over its slice of
+        key features (decayed contributions of the sub-blocks seen so far within
+        this chunk) and adds: (a) within-sub-block pairs computed element-wise in
+        log space (exponents stay <= 0 for g <= 0), (b) earlier-sub-block pairs
+        through m. Writes o_local into O (padded to Lp).
+        """
+        pid = tl.program_id(0)
+        bh = tl.program_id(1)
+        NDV = tl.cdiv(Dv, BV)
+        i_k = pid % NK
+        i_v = (pid // NK) % NDV
+        i_c = pid // (NK * NDV)
+
+        BKS: tl.constexpr = BK // NK
+        offs_k = i_k * BKS + tl.arange(0, BKS)
+        offs_v = i_v * BV + tl.arange(0, BV)
+        mask_k = offs_k < Dk
+        mask_v = offs_v < Dv
+        qk_base = bh * L * Dk
+        v_base = bh * L * Dv
+        o_base = (i_k * BH + bh) * Lp * Dv
+
+        m = tl.zeros((BKS, BV), dtype=tl.float32)
+        i_idx = tl.arange(0, BC)
+        diag = i_idx[:, None] >= i_idx[None, :]
+        for s in tl.static_range(BT // BC):
+            offs_s = i_c * BT + s * BC + i_idx
+            ms = offs_s < L
+            ptr_g = G + qk_base + offs_s[:, None] * Dk + offs_k[None, :]
+            g_s = tl.load(ptr_g, mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+            gloc = tl.cumsum(g_s, axis=0)                      # inclusive, within sub-block
+            q_s = tl.load(Q + qk_base + offs_s[:, None] * Dk + offs_k[None, :],
+                          mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32) * scale
+            k_s = tl.load(K + qk_base + offs_s[:, None] * Dk + offs_k[None, :],
+                          mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+
+            # (b) earlier sub-blocks of this chunk, via the local state
+            o_s = tl.dot(q_s * tl.exp(gloc), m, input_precision=IP)
+
+            # (a) pairs inside the sub-block, element-wise in log space
+            diff = gloc[:, None, :] - gloc[None, :, :]
+            w = tl.exp(tl.where(diag[:, :, None], diff, float("-inf")))
+            A = tl.sum(q_s[:, None, :] * k_s[None, :, :] * w, axis=2)
+
+            v_s = tl.load(V + v_base + offs_s[:, None] * Dv + offs_v[None, :],
+                          mask=ms[:, None] & mask_v[None, :], other=0.0).to(tl.float32)
+            o_s += tl.dot(A, v_s, input_precision=IP)
+
+            # advance the local state to the next sub-block start
+            gend = tl.sum(g_s, axis=0)                         # (BKS,)
+            kw = k_s * tl.exp(gend[None, :] - gloc)
+            m = tl.exp(gend)[:, None] * m + tl.dot(tl.trans(kw), v_s, input_precision=IP)
+
+            tl.store(O + o_base + offs_s[:, None] * Dv + offs_v[None, :], o_s,
+                     mask=mask_v[None, :])
+
+    @triton.jit
+    def _gsr_fused_kernel(Q, K, V, G, O, S0, SF, scale,
+                          L, Lp, Dk, Dv, BH,
+                          BT: tl.constexpr, BC: tl.constexpr,
+                          BK: tl.constexpr, BV: tl.constexpr,
+                          NK: tl.constexpr, IP: tl.constexpr,
+                          HAS_S0: tl.constexpr, WRITE_SF: tl.constexpr):
+        """Single-pass fused kernel. Grid: (NK * ceil(Dv/BV), B*H); each program
+        owns a (BKS, BV) slice of the running state S and walks the whole
+        sequence chunk by chunk. Per chunk it initializes the local state m = S,
+        then per sub-block emits o_s = (q*exp(gloc)) @ m + within-sub-block
+        log-space attention (all exponents <= 0 for g <= 0) and advances m;
+        S := m at the chunk end threads the state across chunks. Each program
+        writes its own key-slice partial output buffer, so stores are race-free.
+        """
+        pid = tl.program_id(0)
+        bh = tl.program_id(1)
+        NDV = tl.cdiv(Dv, BV)
+        i_k = pid % NK
+        i_v = pid // NK
+
+        BKS: tl.constexpr = BK // NK
+        offs_k = i_k * BKS + tl.arange(0, BKS)
+        offs_v = i_v * BV + tl.arange(0, BV)
+        mask_k = offs_k < Dk
+        mask_v = offs_v < Dv
+        qk_base = bh * L * Dk
+        v_base = bh * L * Dv
+        o_base = (i_k * BH + bh) * Lp * Dv
+
+        S = tl.zeros((BKS, BV), dtype=tl.float32)
+        if HAS_S0:
+            S += tl.load(S0 + bh * Dk * Dv + offs_k[:, None] * Dv + offs_v[None, :],
+                         mask=mask_k[:, None] & mask_v[None, :], other=0.0).to(tl.float32)
+
+        i_idx = tl.arange(0, BC)
+        diag = i_idx[:, None] >= i_idx[None, :]
+        tril_f = diag.to(tl.float32)
+        for c in range(tl.cdiv(L, BT)):
+            m = S
+            for s in tl.static_range(BT // BC):
+                offs_s = c * BT + s * BC + i_idx
+                ms = offs_s < L
+                g_s = tl.load(G + qk_base + offs_s[:, None] * Dk + offs_k[None, :],
+                              mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+                gloc = tl.dot(tril_f, g_s, input_precision="ieee")  # inclusive cumsum
+                q_s = tl.load(Q + qk_base + offs_s[:, None] * Dk + offs_k[None, :],
+                              mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32) * scale
+                k_s = tl.load(K + qk_base + offs_s[:, None] * Dk + offs_k[None, :],
+                              mask=ms[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+
+                # everything written before this sub-block, via the carried state
+                o_s = tl.dot(q_s * tl.exp(gloc), m, input_precision=IP)
+
+                # pairs inside the sub-block, element-wise in log space
+                diff = gloc[:, None, :] - gloc[None, :, :]
+                w = tl.exp(tl.where(diag[:, :, None], diff, float("-inf")))
+                A = tl.sum(q_s[:, None, :] * k_s[None, :, :] * w, axis=2)
+
+                v_s = tl.load(V + v_base + offs_s[:, None] * Dv + offs_v[None, :],
+                              mask=ms[:, None] & mask_v[None, :], other=0.0).to(tl.float32)
+                o_s += tl.dot(A, v_s, input_precision=IP)
+
+                # advance the state to the next sub-block start
+                gend = tl.sum(g_s, axis=0)                     # (BKS,)
+                kw = k_s * tl.exp(gend[None, :] - gloc)
+                m = tl.exp(gend)[:, None] * m + tl.dot(tl.trans(kw), v_s, input_precision=IP)
+
+                tl.store(O + o_base + offs_s[:, None] * Dv + offs_v[None, :], o_s,
+                         mask=mask_v[None, :])
+            S = m
+
+        if WRITE_SF:
+            tl.store(SF + bh * Dk * Dv + offs_k[:, None] * Dv + offs_v[None, :], S,
+                     mask=mask_k[:, None] & mask_v[None, :])
+
+    @triton.jit
+    def _gsr_inter_kernel(Q, K, V, G, O, S0, SF, scale,
+                          L, Lp, Dk, Dv, BH,
+                          BT: tl.constexpr, BK2: tl.constexpr, BV2: tl.constexpr,
+                          HAS_S0: tl.constexpr, WRITE_SF: tl.constexpr,
+                          IP: tl.constexpr):
+        """Inter-chunk part: o[t] += (scale*q_t * exp(G_t)) @ S_c restricted to
+        this program's key-feature slice, then advance the slice of the global
+        state S <- diag(exp(G_last)) S + (k * exp(G_last - G))^T @ v, one chunk
+        at a time. Grid: (ceil(Dk/BK2) * ceil(Dv/BV2), B*H). Each program owns
+        its (BK2, BV2) state slice and read-modify-writes only its own
+        (i_k, i_v) output tile of the (i_k)-th partial buffer, so updates are
+        race-free. Also threads the initial state in and the final state out.
+        """
+        pid = tl.program_id(0)
+        bh = tl.program_id(1)
+        nkv = tl.cdiv(Dk, BK2)
+        i_k = pid % nkv
+        i_v = pid // nkv
+
+        offs_k = i_k * BK2 + tl.arange(0, BK2)
+        offs_v = i_v * BV2 + tl.arange(0, BV2)
+        mask_k = offs_k < Dk
+        mask_v = offs_v < Dv
+        qk_base = bh * L * Dk
+        v_base = bh * L * Dv
+        o_base = (i_k * BH + bh) * Lp * Dv
+
+        S = tl.zeros((BK2, BV2), dtype=tl.float32)
+        if HAS_S0:
+            S += tl.load(S0 + bh * Dk * Dv + offs_k[:, None] * Dv + offs_v[None, :],
+                         mask=mask_k[:, None] & mask_v[None, :], other=0.0).to(tl.float32)
+
+        i_t = tl.arange(0, BT)
+        for c in range(tl.cdiv(L, BT)):
+            offs_t = c * BT + i_t
+            mt = offs_t < L
+            g_t = tl.load(G + qk_base + offs_t[:, None] * Dk + offs_k[None, :],
+                          mask=mt[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+            Gc = tl.cumsum(g_t, axis=0)
+            q_t = tl.load(Q + qk_base + offs_t[:, None] * Dk + offs_k[None, :],
+                          mask=mt[:, None] & mask_k[None, :], other=0.0).to(tl.float32) * scale
+            o_t = tl.dot(q_t * tl.exp(Gc), S, input_precision=IP)
+            o_ptr = O + o_base + offs_t[:, None] * Dv + offs_v[None, :]
+            o_prev = tl.load(o_ptr, mask=mask_v[None, :], other=0.0)
+            tl.store(o_ptr, o_prev + o_t, mask=mask_v[None, :])
+
+            k_t = tl.load(K + qk_base + offs_t[:, None] * Dk + offs_k[None, :],
+                          mask=mt[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
+            v_t = tl.load(V + v_base + offs_t[:, None] * Dv + offs_v[None, :],
+                          mask=mt[:, None] & mask_v[None, :], other=0.0).to(tl.float32)
+            Gl = tl.sum(g_t, axis=0)
+            kw = k_t * tl.exp(Gl[None, :] - Gc)
+            S = tl.exp(Gl)[:, None] * S + tl.dot(tl.trans(kw), v_t, input_precision=IP)
+
+        if WRITE_SF:
+            tl.store(SF + bh * Dk * Dv + offs_k[:, None] * Dv + offs_v[None, :], S,
+                     mask=mask_k[:, None] & mask_v[None, :])
+
+
+# intra-kernel launch configuration; overridable for tuning
+_INTRA_CFG = {"BT": 16, "BV": 128, "BKS": 32, "W": 4, "IP": "ieee"}
+# inter-kernel launch configuration
+_INTER_CFG = {"BV": 128, "W": 4, "IP": "tf32x3"}
+# use the single-pass fused kernel when True, intra+inter pair otherwise
+_FUSED = True
+
 
