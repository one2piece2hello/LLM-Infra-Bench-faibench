+@triton.jit
+def _combine_attn_states_kernel(
+    po_ptr, pl_ptr, out_ptr, lse_ptr,
+    N, R, D,
+    s_on, s_or, s_od,
+    s_ln, s_lr,
+    BLOCK_N: tl.constexpr, BLOCK_R: tl.constexpr, BLOCK_D: tl.constexpr,
+    NSTAGE: tl.constexpr,
+):
+    pid_r = tl.program_id(0)
+    pid_d = tl.program_id(1)
+    rows = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
+    r_mask = rows < R
+
+    # Log-domain max and denominator over this tile's rows (single small load).
+    ns = tl.arange(0, BLOCK_N)
+    lse_vec = tl.load(pl_ptr + ns[:, None] * s_ln + rows[None, :] * s_lr,
+                      mask=(ns[:, None] < N) & r_mask[None, :],
+                      other=float("-inf")).to(tl.float32)
+    m = tl.max(lse_vec, axis=0)                            # (BLOCK_R,)
+    m_safe = tl.where((m == float("inf")) | (m == float("-inf")), 0.0, m)
+    w = tl.exp(lse_vec - m_safe[None, :])                  # (BLOCK_N, BLOCK_R)
+    denom = tl.sum(w, axis=0)                              # (BLOCK_R,)
+
+    d_off = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    d_mask = d_off < D
+    acc = tl.zeros([BLOCK_R, BLOCK_D], dtype=tl.float32)
+    for n in tl.range(0, N, num_stages=NSTAGE):
+        ln = tl.load(pl_ptr + n * s_ln + rows * s_lr, mask=r_mask,
+                     other=float("-inf")).to(tl.float32)
+        wn = tl.exp(ln - m_safe)
+        x = tl.load(po_ptr + n * s_on + rows[:, None] * s_or + d_off[None, :] * s_od,
+                    mask=r_mask[:, None] & d_mask[None, :], other=0.0).to(tl.float32)
+        acc += wn[:, None] * x
+
+    finite = denom > 0
+    safe_denom = tl.where(finite, denom, 1.0)
+    res = tl.where(finite[:, None], acc / safe_denom[:, None], 0.0)
+    # ``out`` is always a freshly allocated contiguous (R, D) tensor.
+    tl.store(out_ptr + rows[:, None] * D + d_off[None, :],
+             res.to(out_ptr.dtype.element_ty),
+             mask=r_mask[:, None] & d_mask[None, :])
+    if pid_d == 0:
+        lse_val = tl.where(finite, tl.log(safe_denom) + m_safe, float("-inf"))
+        tl.store(lse_ptr + rows, lse_val.to(lse_ptr.dtype.element_ty), mask=r_mask)
+
+
+_kernel_cache = {}
+_get_raw_stream = torch._C._cuda_getCurrentRawStream
+
+
+def _build_launcher(partial_out, partial_lse, out, lse, N, R, D, key):
+    elt = partial_out.element_size()
+    if R >= 8192:
+        # Enough row-blocks to fill the GPU: wider rows amortize the lse work.
+        BLOCK_R = 16
+        num_warps = 4 if elt == 2 else 2
+        BLOCK_D = min(256 // elt, triton.next_power_of_2(max(D, 1)))
+        if elt == 2 and N >= 16:
+            NSTAGE = 6 if D > 128 else 4
+        else:
+            NSTAGE = 1
+    elif R >= 2048 and elt == 2:
+        BLOCK_R = 8
+        num_warps = 4
+        BLOCK_D = min(512 // elt, triton.next_power_of_2(max(D, 1)))
+        NSTAGE = 4 if N >= 16 else 1
+    else:
+        # Small/medium grids: narrow row-blocks to keep every SM busy.
+        BLOCK_R = 4
+        num_warps = 2
+        BLOCK_D = min(512 // elt, triton.next_power_of_2(max(D, 1)))
+        NSTAGE = 4 if N >= 16 else 1
+    BLOCK_N = triton.next_power_of_2(max(N, 1))
+    s_on, s_or, s_od = partial_out.stride()
+    s_ln, s_lr = partial_lse.stride()
+    ck = _combine_attn_states_kernel.warmup(
+        partial_out, partial_lse, out, lse, N, R, D,
+        s_on, s_or, s_od, s_ln, s_lr,
+        BLOCK_N=BLOCK_N, BLOCK_R=BLOCK_R, BLOCK_D=BLOCK_D, NSTAGE=NSTAGE,
+        num_warps=num_warps, grid=(1,))
+    ck._init_handles()
+    gx = triton.cdiv(R, BLOCK_R)
+    gy = max(triton.cdiv(D, BLOCK_D), 1)
+    tail = (N, R, D, s_on, s_or, s_od, s_ln, s_lr,
+            BLOCK_N, BLOCK_R, BLOCK_D, NSTAGE)
+    run = ck.run
+    function = ck.function
+    metadata = ck.packed_metadata
+
+    def launch(stream, po, pl, o, l):
+        run(gx, gy, 1, stream, function, metadata, None, None, None,
+            po, pl, o, l, *tail)
+
+    _kernel_cache[key] = launch
+    return launch
