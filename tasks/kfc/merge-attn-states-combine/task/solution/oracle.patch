+# removes the per-call allocation and launch overhead. Replay re-reads the
+# current contents of the same input pointers, so results are identical to the
+# direct path; the outputs live in static per-key buffers.
+_graph_cache = {}
+_graphs_enabled = [True]
+_CAPTURE_AFTER = 3
